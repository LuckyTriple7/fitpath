# .env im Stack-Ordner (neben compose.yml)
FITPATH_PUBLIC_URL=https://fitpath.example.org

# KI (optional), jeder OpenAI-kompatible Endpunkt. Ohne Key ist die KI aus. Beispiele:
#   LiteLLM     URL=http://litellm:4000            KEY=virtueller Key   MODEL=Name wie in LiteLLM
#   OpenRouter  URL=https://openrouter.ai/api/v1   KEY=sk-or-…          MODEL=z. B. anthropic/<modell>
#   OpenAI      URL=https://api.openai.com/v1      KEY=sk-…             MODEL=z. B. ein kleines GPT-Modell
#   Ollama      URL=http://ollama:11434/v1         KEY=ollama (egal)    MODEL=lokal geladenes Modell
FITPATH_AI_URL=
FITPATH_AI_KEY=
FITPATH_AI_MODEL=
# FITPATH_AI_HEADERS={"HTTP-Referer": "https://fitpath.example.org"}

# optional
# FITPATH_OFF_CONTACT=          # Kontakt-E-Mail im User-Agent für Open Food Facts
# FITPATH_PORT=8800
# TZ=Europe/Berlin
# Alte Namen gelten weiter: FITPATH_LITELLM_URL, FITPATH_LITELLM_KEY, FITPATH_MODEL_FAST
